(define (swap [a : (Vect Int)]) : (Int -> (Int -> Unit)) (lambda ([i : Int]) (lambda ([j : Int])
  (if (= i j)
    ()
    (let ([t : Int (vector-ref a i)])
      (begin
        (vector-set! a i (vector-ref a j))
        (vector-set! a j t)))))))

(define (partition [a : (Vect Int)]) : (Int -> (Int -> Int)) (lambda ([p : Int]) (lambda ([r : Int])
  (let ([i : (Ref Int) (box (- p 1))]
        [x : Int (vector-ref a r)])
    (begin
      (repeat (j p r) (_ : Unit ())
        (if (<= (vector-ref a j) x)
          (begin
            (box-set! i (+ (unbox i) 1))
            (((swap a) (unbox i)) j))
          ())
	  )
      (((swap a) (+ (unbox i) 1)) r)
      (+ (unbox i) 1))))))

(define (sort [a : (Vect Int)]) : (Int -> (Int -> Unit)) (lambda ([p : Int]) (lambda ([r : Int])
  (if (< p r)
    (let ([q : Int (((partition a) p) r)])
      (begin
        (((sort a) p) (- q 1))
        (((sort a) (+ q 1)) r)))
    ()))))

(define (benchmark) : Unit
  (let ([size : Int (read-int)])
    (let ([a : (Vect Int) (vector size 1)])
        (begin
          (repeat (i 0 size) (_ : Unit ())
            (vector-set! a i (read-int))
          )
          (((sort a) 0) (- size 1))
          (print-int (vector-ref a (- size 1)))))))

